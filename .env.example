# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

DATABASE_URL=sqlite:///./app.db

# JWT
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP
OTP_EXPIRE_MINUTES=15

# Correo: "console" imprime el OTP en la terminal (SOLO desarrollo, sin SMTP).
# Usa "smtp" para enviar correos reales (obligatorio en producción).
EMAIL_BACKEND=console

# SMTP (solo se usa con EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=tu_correo@gmail.com
